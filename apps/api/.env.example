# Copy to .env and change the secrets before going live.
PORT=4000
# Where the web app runs (CORS) and the base of QR code links
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Long random strings. JWT_SECRET signs logins; APP_SECRET encrypts payment keys stored in the database.
JWT_SECRET=change-me-to-a-long-random-string
APP_SECRET=change-me-to-another-long-random-string

# sqljs = a local file (great for trying it out). postgres = production.
DB_TYPE=sqljs
# DB_LOCATION=data/orderia.sqlite
# DB_TYPE=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/orderia
# DB_SYNC=false   # once you use migrations
